}
function quotaTokenFireBurnMask(chars) {
  const burn = new Array(chars.length).fill(false);
  let runStart = -1;
  let runHasDigit = false;
  for (let i = 0; i <= chars.length; i++) {
    const isNumChar = i < chars.length && /[0-9KMB.()]/u.test(chars[i]);
    if (isNumChar) {
      if (runStart < 0) {
        runStart = i;
