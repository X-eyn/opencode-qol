      append: "home.footer.status",
      render: () => _$createComponent(QuotaFooter, {
        context: api,
        surface: "home"
      })
    });
    return () => {
      disposeEvents?.();
      disposeApp();
      disposeSidebar();
      disposePrompt();
      disposeHome();
    };
  }
});
export default plugin;
